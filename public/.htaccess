Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]

# El servidor sirve los .js como application/x-javascript. Junto a
# X-Content-Type-Options: nosniff, Chrome rechaza ese MIME heredado al cargar
# <script type="module"> y deja la app sin montar, sin mensaje de error.
<IfModule mod_mime.c>
  RemoveType .js .mjs
  AddType text/javascript .js
  AddType text/javascript .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
  # Fuerza HTTPS por un año e incluye subdominios
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Impide que el sitio sea embebido en iframes de terceros (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Evita que el navegador interprete tipos MIME incorrectos
  Header always set X-Content-Type-Options "nosniff"

  # No filtra la URL completa en cabeceras Referer a sitios externos
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Política de permisos: deshabilita acceso a cámara/micrófono/geolocalización no solicitados
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
