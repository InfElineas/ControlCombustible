Options -MultiViews
RewriteEngine On

# /assets/ nunca debe caer en el fallback a index.html: si un bundle falta,
# el rewrite devolvia el HTML con status 200 y las CDN lo cacheaban bajo la
# URL del .js, dejando la app en blanco sin error. Mejor un 404 honesto.
RewriteRule ^assets/ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]

# El servidor sirve los .js como application/x-javascript. Junto a
# X-Content-Type-Options: nosniff, Chrome rechaza ese MIME heredado al cargar
# <script type="module"> y deja la app sin montar, sin mensaje de error.
<IfModule mod_mime.c>
  RemoveType .js .mjs
  AddType text/javascript .js
  AddType text/javascript .mjs
  AddType text/css .css

  # El archivo de instalacion de la aplicacion. Con este tipo, Android ofrece
  # instalarlo al abrirlo; servido como octet-stream se queda en la carpeta de
  # descargas sin que el sistema sepa que hacer con el.
  AddType application/vnd.android.package-archive .apk
</IfModule>

<IfModule mod_headers.c>
  # index.html nunca se cachea: es el archivo que apunta a los bundles con
  # hash. Un index.html viejo pide un bundle que ya no existe y la app queda
  # en blanco. Los assets si llevan hash, asi que cachearlos es seguro.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  SetEnvIf Request_URI "^/assets/" ASSET_INMUTABLE
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ASSET_INMUTABLE

  # El .apk no lleva hash en el nombre: si se cachea, al subir una version
  # nueva la gente seguiria descargando la vieja.
  <FilesMatch "\.apk$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Fuerza HTTPS por un año e incluye subdominios
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Impide que el sitio sea embebido en iframes de terceros (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Evita que el navegador interprete tipos MIME incorrectos
  Header always set X-Content-Type-Options "nosniff"

  # No filtra la URL completa en cabeceras Referer a sitios externos
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Política de permisos: deshabilita acceso a cámara/micrófono/geolocalización no solicitados
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
