PORT=3010

# elineas-auth
AUTH_BASE_URL=http://localhost:8080
AUTH_JWKS_PATH=/api/auth/jwks
# Recomendado en producción: fija quién puede emitir tokens para esta API.
AUTH_ISSUER=
AUTH_AUDIENCE=
SYSTEM_SLUG=combustible
# Segundos que se cachean los permisos de un usuario (revocar un permiso tarda hasta esto).
PERMISSION_TTL_S=30
# Si el IS no responde, se siguen sirviendo permisos ya conocidos durante este tiempo.
PERMISSION_STALE_S=300

# Supabase (solo base de datos; la clave de servicio NUNCA va al navegador)
SUPABASE_URL=https://okcvyuemcxzxvvyfkjzp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Límites por minuto (0 = sin límite)
RATE_LIMIT_USER_PER_MIN=900
RATE_LIMIT_ANON_PER_MIN=120
RATE_LIMIT_FAIL_PER_MIN=30
# true SOLO detrás de un proxy propio que fije X-Forwarded-For
TRUST_PROXY=false

# Orígenes del frontend (web y WebView de Capacitor), separados por comas
ALLOWED_ORIGIN=http://localhost:5173
