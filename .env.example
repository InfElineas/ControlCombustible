# Frontend (Vite). Copiar a .env.local y rellenar.

# Pasarela (combustible-gateway): TODAS las consultas a datos pasan por aquí.
VITE_API_URL=http://localhost:3010

# elineas-auth (servidor de identidad)
# En desarrollo el IS (elineas-auth) escucha en el 8081; en su stack de producción, en el 3001.
VITE_AUTH_URL=http://localhost:8081
VITE_SYSTEM_SLUG=combustible
# Panel de administración de elineas-auth (enlace de Administración > Usuarios)
VITE_AUTH_ADMIN_URL=
# Captcha del login (Cloudflare Turnstile). El IS lo exige en sign-in en producción.
# Es la clave PÚBLICA del widget (no la secreta). Para pruebas locales: 1x00000000000000000000AA
# La clave de servicio del IS (elsk_…) NUNCA va aquí: todo VITE_* queda a la vista en el bundle.
VITE_TURNSTILE_SITE_KEY=

# Supabase: solo para construir las URL públicas de descarga de archivos
# (apk, movimiento-adjuntos). Ya NO se usa la clave anon en el frontend.
VITE_SUPABASE_URL=https://okcvyuemcxzxvvyfkjzp.supabase.co

# App Android: dirección https que Android abre dentro de la aplicación al volver
# de Google (Android App Link verificado). elineas-auth no admite esquemas propios.
VITE_NATIVE_REDIRECT=

# Existentes
VITE_URL_APK=

# =============================================================================
# Docker Compose (docker-compose.yml = desarrollo, docker-compose.prod.yml = producción)
# Copiar este archivo a `.env`: compose lo lee para sustituir las ${VARIABLES}.
# =============================================================================

# Obligatorias en ambos entornos (la pasarela las usa; la clave NUNCA llega al navegador)
SUPABASE_URL=https://okcvyuemcxzxvvyfkjzp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes desde los que el NAVEGADOR llama a la pasarela (separados por comas)
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# elineas-auth visto DESDE DENTRO del contenedor de la pasarela.
#   desarrollo (por defecto): http://host.docker.internal:8081
#   producción (por defecto): http://elineas-auth-backend:8080 por la red AUTH_NETWORK
# AUTH_BASE_URL=
# AUTH_NETWORK=elineas-auth-net

# --- Solo producción -------------------------------------------------------
# Se INCRUSTAN en el bundle al construir la imagen web (cambiarlas = reconstruir).
# Son direcciones PÚBLICAS, las que usa el navegador.
# VITE_API_URL=https://combustible-api.mercadoelineas.com
# VITE_AUTH_URL=https://auth.mercadoelineas.com
# VITE_SUPABASE_URL=https://okcvyuemcxzxvvyfkjzp.supabase.co
# APP_VERSION=0.1.0
# TRUST_PROXY=true
